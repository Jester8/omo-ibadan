# Where the browser finds the backend (repo: ibadanserver-). Defaults to the same host, port 8787.
# NEXT_PUBLIC_WS_URL=wss://YOUR-SERVICE.onrender.com
# NEXT_PUBLIC_API_URL=https://YOUR-SERVICE.onrender.com
# Demo mode is the default: sign up and log in happen in the browser only (no server, no email code).
# Set to 1 to use real server accounts with emailed codes.
# NEXT_PUBLIC_REQUIRE_BACKEND=1
