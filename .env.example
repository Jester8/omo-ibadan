# Backend (server/). Copy to .env and edit. Never commit the real file.
PORT=8787
# Long random string used to sign player tokens. REQUIRED in production.
AUTH_SECRET=change-me-to-a-long-random-string
# Set to 1 to refuse websocket players without a valid token.
REQUIRE_AUTH=0
# Comma-separated origins allowed to call the HTTP API from a browser.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
# SQLite file (defaults to server/data/omo.sqlite)
# DB_PATH=./server/data/omo.sqlite

# Frontend: where the browser finds the backend (defaults to the same host, port 8787).
# NEXT_PUBLIC_WS_URL=ws://localhost:8787
# NEXT_PUBLIC_API_URL=http://localhost:8787
